# ==============================================
# Ride Hailing Backend - Environment Configuration
# ==============================================

# Application Environment
# Options: development, staging, production
APP_ENV=development
GO_ENV=development

# Server Configuration
SERVER_PORT=8080

# ==============================================
# PostgreSQL Database Configuration
# ==============================================

# PostgreSQL Container Initial Configuration
POSTGRES_DB=ride_hailing_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=RideHailing@Dev2024

# Application Database Connection
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=RideHailing@Dev2024
DB_NAME=ride_hailing_db
DB_SSLMODE=disable

# Database Connection Pool Configuration
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=50
DB_CONN_MAX_LIFETIME=300

# ==============================================
# JWT Authentication Configuration
# ==============================================

# JWT Secret Keys (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET_KEY=ride_hailing_access_secret_key_dev_change_in_prod
JWT_ACCESS_TIME_MINUTE=60
JWT_REFRESH_SECRET_KEY=ride_hailing_refresh_secret_key_dev_change_in_prod
JWT_REFRESH_TIME_HOUR=168
JWT_ISSUER=ride-hailing-api

# ==============================================
# Initial Admin User Configuration
# ==============================================

START_USER_EMAIL=admin@ridehailing.com
START_USER_PW=Admin@123
